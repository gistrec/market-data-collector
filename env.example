# Copy to .env on the host. Kafka API key of the marketdata-collector service
# account: `terraform output -json kafka_clients` in infra/terraform/confluent.
KAFKA_BOOTSTRAP=pkc-xxxxx.europe-north1.gcp.confluent.cloud:9092
KAFKA_API_KEY=
KAFKA_API_SECRET=

# Optional (defaults shown).
# MDC_BASES=BTC,ETH,BNB,SOL,ADA,XRP,DOGE
# MDC_EXCHANGES=binance,kraken
# MDC_BINANCE_QUOTE=USDT
# MDC_KRAKEN_QUOTE=USD
# MDC_LINGER_MS=500
